# Copy to .env and adjust. Never commit the real .env file.

# --- Application database (used by the API and by Alembic) ---
# Local run (PostgreSQL on localhost):
DATABASE_URL=postgresql+psycopg://expense_user:change_me@localhost:5432/expense_db

# --- Used by docker-compose.yml to create the PostgreSQL container ---
POSTGRES_USER=expense_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=expense_db

# --- Optional: database used by the pytest suite ---
# Leave unset to run the tests on a temporary SQLite file. Point it at an
# EMPTY PostgreSQL database to run them against PostgreSQL (tables are
# created and dropped by the tests, so never use your real database).
# TEST_DATABASE_URL=postgresql+psycopg://expense_user:change_me@localhost:5432/expense_test
